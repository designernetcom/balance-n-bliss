  "url": "https://balance-bliss.in/contact.html",
  "name": "Contact Balance & Bliss – Book a Therapy Session",
  "description": "Contact Balance & Bliss to schedule counselling sessions.  Call, email or complete the form to begin your therapy journey.",
  "mainEntity": {
    "@type": "Psychologist",
    "@id": "https://balance-bliss.in/#psychologist"
  }
}





</script>
