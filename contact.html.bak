<STYle>
  /* WRAPPER */
.contact-wrapper {
  padding: 80px;
  background: #f7f9f8;
  border-radius: 30px;
}

/* FORM CARD */
.contact-form-card {
  background: #ffffff;
  padding: 50px;
  border-radius: 22px;
  box-shadow: 0 20px 50px rgba(0,0,0,0.08);
}

/* INPUTS */
.contact-form-card .form-control {
  padding: 15px 18px;
  border-radius: 12px;
  border: 1px solid #e5e7eb;
  font-size: 15px;
}

.contact-form-card .form-control:focus {
  border-color: #2f6b2f;
  box-shadow: 0 0 0 4px rgba(47,107,47,0.15);
}

/* BUTTON */
.btn-submit {
  background: #2f6b2f;
  color: #ffffff;
  padding: 14px 40px;
  border-radius: 30px;
  border: none;
  font-size: 15px;
  transition: 0.3s;
}

.btn-submit:hover {
  transform: translateY(-2px);
  box-shadow: 0 12px 25px rgba(47,107,47,0.35);
}

/* INFO CARD */
.contact-info-card {
  height: 100%;
  background: #2f6b2f;
  color: #ffffff;
  padding: 50px;
  border-radius: 22px;
}

/* INFO ITEM */
.info-item {
  display: flex;
  gap: 18px;
  margin-bottom: 30px;
}

/* ICON */
.info-icon {
  min-width: 48px;
  height: 48px;
  background: rgba(255,255,255,0.15);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.info-icon i {
  color: #ffffff;
  font-size: 18px;
}

/* TEXT */
.info-text span {
  font-size: 14px;
  opacity: 0.85;
}

.info-text p,
.info-text a {
  font-size: 15px;
  color: #ffffff;
  margin: 0;
  text-decoration: none;
}

/* MOBILE */
@media (max-width: 991px) {
  .contact-wrapper {
    padding: 40px 20px;
  }

  .contact-form-card,
  .contact-info-card {
    padding: 35px 25px;
  }
}

</STYle>

